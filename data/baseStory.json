            },
            "characterSheet": "characters/atrium-scavenger.json",
            "roamRooms": ["atrium", "hallway"]
        },
        {
            "id": "byte-smith",
            "name": "Byte Smith",
            "baseName": "Smith",
            "title": "Static Machinist",
            "roomId": "hallway",
            "position": { "x": 9, "y": 4 },
            "dialog": [
                "Bring me ore and scrap; I'll solder you miracles.",
                "My forge hums at 8-bit. Anything higher melts the keys.",
                "Every loop I redraw my own sprite. It's therapy."
            ],
            "trade": {
                "requires": { "ore": 1, "scrap": 1 },
                "gives": { "toolkit": 1 },
                "flavor": "The Byte Smith hands you a neatly wired toolkit."
            },
            "characterSheet": "characters/byte-smith.json",
            "roamRooms": ["hallway"]
        }
