{
    "baseHistory": {
        "title": "Static Loop",
        "summary": "Each dawn the Static Storm rewinds the 8-bit vault. Secure the stabiliser core before the echo wipes the survivors and start the loop anew.",
        "coreBeats": [
            {
                "id": "briefing",
                "description": "Wake in the Crumbling Atrium and receive the Loop Warden's briefing.",
                "flags": { "mustExistInBase": true }
            },
            {
                "id": "stabiliser-core",
                "description": "Traverse the shuffling vault wings and reclaim the stabiliser core.",
                "flags": { "mustExistInBase": true }
            },
            {
                "id": "evacuation",
                "description": "Reach an active exit door before the static surge collapses the run.",
                "flags": { "mustExistInBase": true }
            }
        ],
        "storyPillars": [
            "Doomed time loop told through crunchy pixel tableaux.",
            "Resourceful survivors bartering scraps for hope.",
            "Modular vault wings that shuffle but keep sacred anchors."
        ]
    },
    "styleGuide": {
        "aesthetic": "8-bit dungeon crawler",
        "tileSize": "16x16",
        "palette": ["#080b12", "#1f2840", "#4a7cb5", "#b54a4a", "#ffd27f", "#e0b874"],
        "lighting": "High contrast shadows with cyan rim-lights on interactive props.",
        "sprites": {
            "outline": "1px midnight outline around every sprite.",
            "animation": "Two-frame idle bounce and four-frame cardinal walk cycles."
        },
        "audioNotes": [
            "Square-wave pads for ambience",
            "Noise-channel crackle for static effects",
            "Triad arpeggios for pickups and crafting"
        ]
    },
    "world": {
        "playerStartRoom": "atrium",
        "playerStartPosition": { "x": 2, "y": 6 },
        "timeLimitTurns": 120,
        "loopFlavor": [
            "The loop rewinds at dawn. Collect anchors fast.",
            "Static charges build with every step you take.",
            "Remember which doors stayed loyal to the base story."
        ]
    },
    "dialogSnippets": {
        "npcDescriptors": ["Cipher", "Echo", "Shifting", "Vagrant", "Veil", "Stray", "Pulse", "Glitched"],
        "npcMoods": ["Keeper of Echoes", "Reluctant Ally", "Data-Robbed", "Glitching Trader", "Loop Scholar", "Static Cartographer"],
        "npcDialogue": [
            "The walls remember each footstep.",
            "Keys rust faster in the static.",
            "Trade sparks for something brighter.",
            "If the switches hum, doors obey.",
            "Enemies forget, but the vault never does.",
            "8-bit stars are painted on the ceiling for luck."
        ],
        "npcOpeners": [
            "Your pixels look fresher than mine, looper.",
            "Another dawn, another glitch to fix.",
            "Static made you taller this time."
        ],
        "tradeFlavors": [
            "Circuits realign in your favor.",
            "A fair loopback exchange.",
            "Static crackles as the deal completes.",
            "Bits swap hands with a soft chime."
        ],
        "itemFlavors": [
            "The key vibrates with latent charge.",
            "A warm glow pulses from the shard.",
            "This gear survived more loops than you did.",
            "The plastic smells faintly of ozone."
        ],
        "loreHooks": [
            "A whisper claims the vault core was sung into existence.",
            "Blue torches reveal glyphs hidden in plain sight.",
            "Static storms cleanse memory but spare the anchors.",
            "The 8-bit murals shift when no one is watching."
        ],
        "goalRewards": [
            "You stabilise the loop for another dawn.",
            "The vault yields a resonant shard.",
            "Future loops will echo this victory.",
            "A chorus of square waves celebrates your win."
        ],
        "ambientWhispers": [
            "Static rain patters against unseen windows.",
            "Something stares from the switch-lit corridor.",
            "Your footsteps phase in a second behind you.",
            "A chiptune lullaby drifts through cracked speakers."
        ],
        "puzzleHints": [
            "Boxes belong on humming panels.",
            "Red doors listen to switch songs.",
            "Mirrored paths hide pressure plates.",
            "Count tiles in eights; the loop honours the rhythm."
        ]
    },
    "craftingRecipes": [
        {
            "id": "torch",
            "name": "Static Torch",
            "requires": { "wood": 2, "ore": 1 },
            "produces": { "torch": 1 },
