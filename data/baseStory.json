        {
            "id": "loopTonic",
            "name": "Loop Tonic",
            "requires": { "wood": 1, "scrap": 2 },
            "produces": { "tonic": 1 },
            "description": "Restores a single heart when consumed."
        }
    ],
    "npcs": [
        {
            "id": "warden",
            "name": "Loop Warden",
            "baseName": "Warden",
            "title": "Anchor Steward",
            "roomId": "atrium",
            "position": { "x": 6, "y": 3 },
            "dialog": [
                "You are expected, looper.",
                "Do not disturb the anchors flagged with gold.",
                "Trade a gem and I will attune a blue key for you."
            ],
            "trade": {
                "requires": { "gem": 1 },
                "gives": { "key:blue": 1 },
